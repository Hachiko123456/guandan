{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git reset)",
      "Bash(git reset *)",
      "Bash(git clean)",
      "Bash(git clean *)",
      "Bash(git checkout)",
      "Bash(git checkout *)",
      "Bash(git restore)",
      "Bash(git restore *)",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(rmdir *)",
      "Bash(del *)",
      "Bash(Remove-Item *)"
    ]
  }
}
